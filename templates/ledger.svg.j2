{% import "_kit.svg.j2" as k with context %}
{% set n = rows | length %}
{% set w, h = 1200, 330 + n * 60 + 70 %}
{% set top, bottom = 325, 325 + (n - 1) * 60 %}
{% call k.frame(w, h, "Chain of custody ledger", total ~ " sealed entries. Head " ~ head.hash ~ ". Verify with python verify.py.") %}
{{ k.label(64, 68, "CHAIN OF CUSTODY", "accent") }}
{{ k.label(1136, 68, "SHA-256  ·  APPEND-ONLY", "muted", "end") }}
<line class="rule" x1="64" y1="92" x2="1136" y2="92"/>

<text x="62" y="160" class="display ink" font-size="46" letter-spacing="-0.92">{{ total | group }} sealed observation{{ "" if total == 1 else "s" }}</text>
<text x="64" y="198" class="sans muted" font-size="19">Each day of public activity is hashed into the entry that follows it. Alter one, and every later hash breaks.</text>

{{ k.label(112, 262, "NO.", "faint", "start", 15) }}
{{ k.label(196, 262, "SEALED", "faint", "start", 15) }}
{{ k.label(356, 262, "EVIDENCE", "faint", "start", 15) }}
{{ k.label(716, 262, "PREV", "faint", "start", 15) }}
{{ k.label(926, 262, "HASH", "faint", "start", 15) }}
<line class="rule" x1="64" y1="280" x2="1136" y2="280"/>

{% if n > 1 %}
<line x1="76" y1="{{ bottom }}" x2="76" y2="{{ top }}" stroke="{{ t.rule }}" stroke-width="1.5"/>
<line class="flow" x1="76" y1="{{ bottom }}" x2="76" y2="{{ top }}" stroke="{{ t.accent }}" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="22 {{ bottom - top }}">
<animate attributeName="stroke-dashoffset" from="{{ bottom - top + 22 }}" to="0" dur="3.2s" repeatCount="indefinite"/>
</line>
{% endif %}

{% for entry in rows %}
{% set y = 330 + loop.index0 * 60 %}
{% set e = entry.evidence %}
{% set summary = e.contributions ~ " contribution" ~ ("" if e.contributions == 1 else "s") ~ "  ·  " ~ (e.heads | length) ~ " heads  ·  " ~ (e.upstream | length) ~ " upstream" %}
{% if loop.first %}
<circle class="pulse" cx="76" cy="{{ y - 5 }}" r="5" fill="{{ t.accent }}"/>
<circle cx="76" cy="{{ y - 5 }}" r="5" fill="{{ t.accent }}"/>
{% else %}
<circle cx="76" cy="{{ y - 5 }}" r="4.5" fill="{{ t.ground }}" stroke="{{ t.muted }}" stroke-width="1.5"/>
{% endif %}
<g class="rise" style="animation-delay:{{ (0.5 + loop.index0 * 0.1) | round(2) }}s">
<text x="112" y="{{ y }}" class="mono-medium ink" font-size="15">{{ "%04d" | format(entry.seq + 1) }}</text>
<text x="196" y="{{ y }}" class="mono ink" font-size="15">{{ entry.date }}</text>
<text x="356" y="{{ y }}" class="sans muted" font-size="16">{{ fit(summary, "sans", 16, 330) }}</text>
<text x="716" y="{{ y }}" class="mono muted" font-size="14">{{ "genesis" if entry.seq == 0 else entry.prev | short(8, 4) }}</text>
<text x="926" y="{{ y }}" class="mono-medium {{ 'accent' if loop.first else 'ink' }}" font-size="14">{{ entry.hash | short(12, 6) }}</text>
</g>
{% if not loop.last %}<line class="rule" x1="112" y1="{{ y + 25 }}" x2="1136" y2="{{ y + 25 }}" opacity=".6"/>{% endif %}
{% endfor %}

<line class="rule" x1="64" y1="{{ h - 70 }}" x2="1136" y2="{{ h - 70 }}"/>
<text x="64" y="{{ h - 34 }}" class="mono" font-size="14"><tspan class="accent">$ </tspan><tspan class="ink">git clone https://github.com/{{ config.SUBJECT }}/{{ config.SUBJECT }} &amp;&amp; cd {{ config.SUBJECT }} &amp;&amp; python verify.py</tspan></text>
{{ k.label(1136, h - 34, "GENESIS  " ~ genesis.date, "faint", "end", 15) }}
{% endcall %}
